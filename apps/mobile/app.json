{
  "expo": {
    "name": "PocketPilot AI",
    "slug": "pocketpilot-ai",
    "version": "1.0.2",
    "icon": "./assets/pocketpilot-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "ai.pocketpilot.mobile",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/pocketpilot-icon.png",
        "backgroundColor": "#050806"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PocketPilot to photograph error messages for private on-device text recognition.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PocketPilot to choose a screenshot for private on-device text recognition."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow PocketPilot to hear push-to-talk voice commands.",
          "speechRecognitionPermission": "Allow PocketPilot to turn push-to-talk speech into safe app commands.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "rn-mlkit-ocr",
        {
          "ocrModels": [
            "latin"
          ],
          "ocrUseBundled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/pocketpilot-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#050806",
          "dark": {
            "image": "./assets/pocketpilot-icon.png",
            "backgroundColor": "#050806"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "91e301cd-eae7-43e7-86ca-84f0eb1723c8"
      }
    },
    "owner": "zeroday-404"
  }
}
