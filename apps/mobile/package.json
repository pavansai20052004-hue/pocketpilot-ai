{
  "name": "@pocketpilot/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "prestart": "npm run build --workspace=@pocketpilot/shared-types",
    "start": "expo start",
    "android": "expo run:android",
    "android:metro": "expo start --dev-client",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.15",
    "@pocketpilot/shared-types": "0.1.0",
    "expo": "57.0.19",
    "expo-build-properties": "57.0.16",
    "expo-camera": "~57.0.4",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-image-manipulator": "57.0.15",
    "expo-image-picker": "57.0.15",
    "expo-secure-store": "~57.0.3",
    "expo-speech": "57.0.2",
    "expo-speech-recognition": "57.0.0",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.2",
    "rn-mlkit-ocr": "0.3.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.3",
    "babel-preset-expo": "57.0.10",
    "jsdom": "^30.0.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-build-properties",
        "expo-image-manipulator",
        "expo-image-picker"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "rn-mlkit-ocr"
        ]
      }
    }
  }
}
