# FastAPI service
POCKETPILOT_AGENT_HOST=127.0.0.1
POCKETPILOT_AGENT_PORT=8000
# Optional explicit LAN address advertised by pairing responses.
POCKETPILOT_ADVERTISED_HOST=
POCKETPILOT_LOG_LEVEL=info
POCKETPILOT_MAX_FILES=20000
POCKETPILOT_MAX_FILE_SIZE=1048576
POCKETPILOT_MAX_REPOSITORY_SCAN_SIZE=104857600
POCKETPILOT_COMMAND_TIMEOUT_SECONDS=120
POCKETPILOT_MAX_COMMAND_OUTPUT_BYTES=1048576
POCKETPILOT_DESKTOP_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
POCKETPILOT_MOBILE_WEB_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
POCKETPILOT_SESSION_DATABASE_PATH=.pocketpilot/sessions.db

# Local AI analysis (mock is deterministic and requires no model runtime)
POCKETPILOT_LLM_PROVIDER=mock
POCKETPILOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
POCKETPILOT_OLLAMA_MODEL=qwen3-coder:30b
POCKETPILOT_OLLAMA_TIMEOUT_SECONDS=300
POCKETPILOT_OLLAMA_CONTEXT_TOKENS=8192
POCKETPILOT_OLLAMA_MAX_OUTPUT_TOKENS=2048
POCKETPILOT_OLLAMA_KEEP_ALIVE=15m
POCKETPILOT_ANALYSIS_MAX_CONTEXT_FILES=6
POCKETPILOT_ANALYSIS_MAX_CONTEXT_CHARS=24000
POCKETPILOT_ANALYSIS_MAX_LINES_PER_FILE=80
POCKETPILOT_PATCH_MAX_FILES=5
POCKETPILOT_PATCH_MAX_ADDITIONS=100
POCKETPILOT_PATCH_MAX_CHANGE_RATIO=0.6
POCKETPILOT_PAIRING_CODE_TTL_SECONDS=300
POCKETPILOT_PAIRING_MAX_ATTEMPTS=5
POCKETPILOT_DEVICE_TOKEN_TTL_SECONDS=86400

# Frontend clients
VITE_AGENT_HTTP_URL=http://127.0.0.1:8000
EXPO_PUBLIC_AGENT_HTTP_URL=http://127.0.0.1:8000
